{
  "skill": "surface",
  "note": "Canonical test cases. Each case: a prompt, the expected matched rule, and the expected format. Walk policy.yaml top-to-bottom; first match wins. Cases s-prefixed were promoted from the adversarial breadth review (ITERATION-LOG.md) to guard the v0.2 rule changes.",
  "cases": [
    {
      "id": "code-review-human",
      "prompt": "Review this PR and tell me what's wrong with the streaming logic.",
      "signals": { "intent": "code-review", "consumer": "human-once", "size": "medium", "content": "mixed" },
      "expect": { "matchedRule": "Code review for humans → HTML", "format": "html" }
    },
    {
      "id": "spec-agent-next",
      "prompt": "Draft a PRD for our new payments service. The architect agent will pick this up next.",
      "signals": { "intent": "spec", "consumer": "agent-next", "size": "large", "content": "mixed" },
      "expect": { "matchedRule": "Spec for next agent → hybrid", "format": "hybrid-md-html" }
    },
    {
      "id": "report-rag",
      "prompt": "Summarize these 50 customer support tickets so we can feed them into our RAG store.",
      "signals": { "intent": "report", "consumer": "rag-ingest", "size": "medium", "content": "text-heavy" },
      "expect": { "matchedRule": "RAG ingest → Markdown", "format": "markdown" }
    },
    {
      "id": "data-extract",
      "prompt": "Extract the line items from this invoice.",
      "signals": { "intent": "data-extract", "consumer": "agent-next", "content": "tabular" },
      "expect": { "matchedRule": "Data extraction → JSON", "format": "json" }
    },
    {
      "id": "mockup-visual",
      "prompt": "Show me three layout options for the empty state of our new dashboard.",
      "signals": { "intent": "mockup", "consumer": "human-once", "content": "visual" },
      "expect": { "matchedRule": "Mockup → HTML+SVG", "format": "html+svg" }
    },
    {
      "id": "scratchpad",
      "prompt": "Write a quick summary of our standup.",
      "signals": { "intent": "scratchpad", "consumer": "human-once", "size": "small" },
      "expect": { "matchedRule": "Scratchpad → Markdown", "format": "markdown" }
    },
    {
      "id": "fallback",
      "prompt": "Tell me a fun fact about octopuses.",
      "signals": {},
      "expect": { "matchedRule": "Default fallback", "format": "markdown" }
    },
    {
      "id": "data-extract-human",
      "prompt": "Extract the contract key terms and save them to our records.",
      "signals": { "intent": "data-extract", "consumer": "human-archive", "content": "structured" },
      "expect": { "matchedRule": "Data extraction for humans → Markdown", "format": "markdown" }
    },
    {
      "id": "doc-runbook",
      "prompt": "Write the on-call runbook for the payments service; we'll keep and update it.",
      "signals": { "intent": "doc", "consumer": "human-archive", "size": "medium", "content": "mixed" },
      "expect": { "matchedRule": "Rich doc for humans → hybrid", "format": "hybrid-md-html" }
    },
    {
      "id": "rag-visual",
      "prompt": "Prepare these architecture notes with diagrams for our RAG knowledge base.",
      "signals": { "intent": "report", "consumer": "rag-ingest", "content": "visual" },
      "expect": { "matchedRule": "RAG ingest with visuals → hybrid", "format": "hybrid-md-html" }
    },
    {
      "id": "agent-handoff",
      "prompt": "Review this PR and hand the findings to the auto-fix agent.",
      "signals": { "intent": "code-review", "consumer": "agent-next", "content": "mixed" },
      "expect": { "matchedRule": "Structured handoff to agents → JSON", "format": "json" }
    },
    {
      "id": "mockup-agent",
      "prompt": "Generate UI mockups for a vision agent to critique.",
      "signals": { "intent": "mockup", "consumer": "agent-verify", "content": "visual" },
      "expect": { "matchedRule": "Mockup → HTML+SVG", "format": "html+svg" }
    }
  ]
}
